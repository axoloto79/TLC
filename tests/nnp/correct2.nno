procedure pp is
  procedure affiche(x,y : integer) is
    i,j:integer;
  begin
    put(x);
    put(y)
  end;
  a,b,c : integer;
begin
  affiche(1,3);
  get(a);
  b:=a+1;
  put(b)
end.
