// Programme correct
//
//   doit afficher : 
//>120 (factorielle de 5)
//------------------------------------------------------
procedure pp is
  function fa(n : in integer) return integer is
  begin
    if n = 0 then
      return 1
    else
      return n*fa(n-1)
    end
  end;
begin
  put(fa(5))
end.
